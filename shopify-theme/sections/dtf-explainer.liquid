<section class="bg-snow">
  <div class="container">
    <div class="split">
      <div class="split-content">
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="display display-m">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.lede != blank -%}
          <p class="lede">{{ section.settings.lede }}</p>
        {%- endif -%}
        <div class="fact-grid">
          {%- for block in section.blocks -%}
            <div class="fact-cell" {{ block.shopify_attributes }}>
              <div class="fact-label">{{ block.settings.label }}</div>
              <div class="fact-val">{{ block.settings.val }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>
      <div class="split-img">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.heading, loading: 'lazy' }}
        {%- else -%}
          <img src="https://placehold.co/800x1000/111111/FFFFFF.png?text=PRINT+CLOSE-UP" alt="DTF print close-up" loading="lazy">
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DTF Explainer",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Side image (4:5)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What is DTF?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The print tech that does it all." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "DTF (Direct to Film) is the latest in garment printing — full colour, soft feel, works on almost any fabric, and zero minimum orders. It's replaced screen printing for most custom jobs." }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Print Method" },
        { "type": "text", "id": "val", "label": "Value", "default": "Direct to Film (DTF)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DTF Explainer",
      "blocks": [
        { "type": "fact", "settings": { "label": "Print Method", "val": "Direct to Film (DTF)" } },
        { "type": "fact", "settings": { "label": "Works On", "val": "Cotton · Poly · Blends · Nylon" } },
        { "type": "fact", "settings": { "label": "Finish", "val": "Soft feel · Vibrant · Wash durable" } },
        { "type": "fact", "settings": { "label": "Minimum", "val": "1 transfer · $0 setup fee" } }
      ]
    }
  ]
}
{% endschema %}
