<section class="hero">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hero-img', alt: section.settings.heading, loading: 'eager', fetchpriority: 'high', widths: '800,1200,1600,2000,2400' }}
  {%- else -%}
    <div class="hero-img" style="background:var(--grey-900)"></div>
  {%- endif -%}
  <div class="hero-scrim"></div>
  <div class="hero-content">
    <div class="hero-content-inner">
      {%- if section.settings.eyebrow != blank -%}
        <div class="eyebrow hero-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="display display-xl hero-title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.sub != blank -%}
        <p class="hero-sub">{{ section.settings.sub }}</p>
      {%- endif -%}
      <div class="hero-btns">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ section.settings.primary_url }}" class="btn btn-primary-on-dark">{{ section.settings.primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_url }}" class="btn btn-secondary-on-dark">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (1920×1080+)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NZ's Fastest DTF Transfers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Custom prints. No limits."
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Subheading",
      "default": "Premium DTF transfers and custom printed garments — no minimums, full colour, 24-hour turnaround. From one shirt to a thousand."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Order Transfers"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Get a Quote"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary button URL"
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "Banner"
    }
  ]
}
{% endschema %}
