<section>
  <div class="container">
    {%- if section.settings.eyebrow != blank -%}
      <div class="eyebrow" style="margin-bottom:12px;text-align:center">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="display display-l text-center" style="margin-bottom:32px">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div style="background:var(--snow);border:1px solid var(--grey-200);border-radius:var(--r-card);padding:48px;min-height:600px">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          {% render block %}
        {%- else -%}
          <div style="text-align:center;padding:48px">
            <p class="lede">Add your gang-sheet builder app here from the theme editor.</p>
            <p class="muted" style="font-size:14px;margin-top:8px">Theme editor → Add block → Apps → Build-a-Gang-Sheet</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "App block container",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Builder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your gang sheet." }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [
    { "name": "App block container" }
  ]
}
{% endschema %}
