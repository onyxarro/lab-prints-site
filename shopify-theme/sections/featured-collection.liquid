<section id="{{ section.settings.anchor | default: 'products' }}">
  <div class="container">
    <div class="section-head">
      <div class="left">
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="display display-l">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link_url }}" class="btn btn-secondary">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    <div class="cat-grid">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.product_count -%}
          <a href="{{ product.url }}" class="cat-card">
            {%- if product.featured_image -%}
              {{ product.featured_image | image_url: width: 1000 | image_tag: alt: product.title, loading: 'lazy' }}
            {%- else -%}
              <img src="https://placehold.co/800x1000/111111/FFFFFF.png?text={{ product.title | url_encode | upcase }}" alt="{{ product.title }}" loading="lazy">
            {%- endif -%}
            <div class="scrim"></div>
            <div class="meta">
              <div class="meta-eyebrow">{{ product.type | default: 'Print' }}</div>
              <div class="meta-title">{{ product.title }}</div>
              <div class="meta-row">
                <span class="meta-price">From {{ product.price_min | money }}</span>
                <span class="meta-cta">Shop</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.url }}" class="cat-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: alt: block.settings.title, loading: 'lazy' }}
            {%- else -%}
              <img src="https://placehold.co/800x1000/111111/FFFFFF.png?text={{ block.settings.title | url_encode | upcase }}" alt="{{ block.settings.title }}" loading="lazy">
            {%- endif -%}
            <div class="scrim"></div>
            <div class="meta">
              {%- if block.settings.eyebrow != blank -%}
                <div class="meta-eyebrow">{{ block.settings.eyebrow }}</div>
              {%- endif -%}
              <div class="meta-title">{{ block.settings.title }}</div>
              <div class="meta-row">
                <span class="meta-price">{{ block.settings.price }}</span>
                <span class="meta-cta">{{ block.settings.cta | default: 'Shop' }}</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "products" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "DTF transfers & custom garments." },
    { "type": "collection", "id": "collection", "label": "Collection (auto-populates from products)" },
    { "type": "range", "id": "product_count", "min": 2, "max": 6, "step": 1, "default": 3, "label": "Products to show" },
    { "type": "text", "id": "link_label", "label": "View-all label", "default": "All Products" },
    { "type": "url", "id": "link_url", "label": "View-all URL" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Manual card (used when no collection set)",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (4:5)" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "By Size" },
        { "type": "text", "id": "title", "label": "Title", "default": "DTF Transfers" },
        { "type": "text", "id": "price", "label": "Price label", "default": "From $2.50 / transfer" },
        { "type": "text", "id": "cta", "label": "CTA label", "default": "Shop" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collection",
      "blocks": [
        { "type": "card", "settings": { "title": "DTF Transfers", "eyebrow": "By Size", "price": "From $2.50 / transfer" } },
        { "type": "card", "settings": { "title": "Gang Sheets", "eyebrow": "Build Your Own", "price": "From $11 / sheet" } },
        { "type": "card", "settings": { "title": "Custom Garments", "eyebrow": "Printed & Ready", "price": "From $25 / garment" } }
      ]
    }
  ]
}
{% endschema %}
