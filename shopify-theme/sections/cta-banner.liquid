<section class="cta" style="padding:0">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'cta-img', alt: section.settings.heading, loading: 'lazy', widths: '800,1200,1600,2000,2400' }}
  {%- else -%}
    <img class="cta-img" src="{{ 'cta.jpg' | asset_url }}" alt="" loading="lazy">
  {%- endif -%}
  <div class="cta-content">
    {%- if section.settings.eyebrow != blank -%}
      <div class="eyebrow cta-eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="display display-l cta-title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.sub != blank -%}
      <p class="cta-sub">{{ section.settings.sub }}</p>
    {%- endif -%}
    <div class="cta-btns">
      {%- if section.settings.primary_label != blank -%}
        <a href="{{ section.settings.primary_url }}" class="btn btn-primary-on-dark">{{ section.settings.primary_label }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a href="{{ section.settings.secondary_url }}" class="btn btn-secondary-on-dark">{{ section.settings.secondary_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image (16:9, sits at 0.45 opacity)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ready to print?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get your quote in minutes." },
    { "type": "textarea", "id": "sub", "label": "Sub", "default": "Tell us what you need. No commitments, no lengthy forms — just a quick, honest quote." },
    { "type": "text", "id": "primary_label", "label": "Primary CTA", "default": "Get a Quote" },
    { "type": "url", "id": "primary_url", "label": "Primary URL" },
    { "type": "text", "id": "secondary_label", "label": "Secondary CTA", "default": "Shop Online" },
    { "type": "url", "id": "secondary_url", "label": "Secondary URL" }
  ],
  "presets": [
    { "name": "CTA banner" }
  ]
}
{% endschema %}
