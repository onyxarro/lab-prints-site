<section id="{{ section.settings.anchor | default: 'why' }}">
  <div class="container">
    <div class="split">
      <div class="split-img">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.heading, loading: 'lazy' }}
        {%- else -%}
          <img src="https://placehold.co/800x1000/111111/FFFFFF.png?text=ATELIER+%E2%80%94+DTF+PRESS" alt="LAB Prints atelier" loading="lazy">
        {%- endif -%}
      </div>
      <div class="split-content">
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="display display-m">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.lede != blank -%}
          <p class="lede">{{ section.settings.lede }}</p>
        {%- endif -%}

        <div class="points">
          {%- for block in section.blocks -%}
            {%- if block.type == 'point' -%}
              <div class="point" {{ block.shopify_attributes }}>
                <div class="point-num">{{ block.settings.num }}</div>
                <div class="point-body">
                  <h4>{{ block.settings.title }}</h4>
                  <p>{{ block.settings.body }}</p>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.show_stats -%}
          <div class="stat-grid">
            {%- for block in section.blocks -%}
              {%- if block.type == 'stat' -%}
                <div class="stat-cell" {{ block.shopify_attributes }}>
                  <div class="stat-num">{{ block.settings.num }}</div>
                  <div class="stat-label">{{ block.settings.label }}</div>
                  <div class="stat-sub">{{ block.settings.sub }}</div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why us",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "why" },
    { "type": "image_picker", "id": "image", "label": "Side image (4:5)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why LAB Prints" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for businesses that move fast." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "No agency delays. No confusing quotes. No minimums holding you back. Just quality prints, fast." },
    { "type": "checkbox", "id": "show_stats", "label": "Show stat grid below points", "default": true }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "num", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "24-Hour Turnaround" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "DTF transfers printed and ready to ship next business day." }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "num", "label": "Stat", "default": "1" },
        { "type": "text", "id": "label", "label": "Label", "default": "Minimum Order" },
        { "type": "text", "id": "sub", "label": "Sub", "default": "As little as a single piece" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why us",
      "blocks": [
        { "type": "point", "settings": { "num": "01", "title": "24-Hour Turnaround", "body": "DTF transfers printed and ready to ship next business day." } },
        { "type": "point", "settings": { "num": "02", "title": "Full Colour, No Setup Fees", "body": "Unlimited colours in your design. What you see on screen is what you get on fabric." } },
        { "type": "point", "settings": { "num": "03", "title": "No Minimum Orders", "body": "Need one transfer or one shirt? No problem. Order exactly what you need." } },
        { "type": "point", "settings": { "num": "04", "title": "100% NZ Based", "body": "Fast local shipping, NZD pricing, and a real person to talk to." } },
        { "type": "stat", "settings": { "num": "1", "label": "Minimum Order", "sub": "As little as a single piece" } },
        { "type": "stat", "settings": { "num": "24HR", "label": "DTF Turnaround", "sub": "Ready next business day" } },
        { "type": "stat", "settings": { "num": "100%", "label": "Full Colour", "sub": "No limits, no extra cost" } },
        { "type": "stat", "settings": { "num": "100+", "label": "Wash Durability", "sub": "Prints that last" } }
      ]
    }
  ]
}
{% endschema %}
