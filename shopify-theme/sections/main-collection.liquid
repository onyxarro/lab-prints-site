<section>
  <div class="container">
    <div class="page-header" style="border:0;padding:48px 0 16px">
      <div class="eyebrow">Shop</div>
      <h1 class="display display-l">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p class="lede">{{ collection.description | strip_html | truncatewords: 40 }}</p>
      {%- endif -%}
    </div>

    <div class="collection-bar">
      <div class="count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</div>
      <div class="collection-filters">
        {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
        {%- assign sorts = 'manual,best-selling,price-ascending,price-descending,created-descending,title-ascending' | split: ',' -%}
        {%- assign labels = 'Featured,Best selling,Price low → high,Price high → low,Newest,A → Z' | split: ',' -%}
        {%- for s in sorts -%}
          <a href="{{ collection.url }}?sort_by={{ s }}" class="filter-pill{% if current_sort == s %} active{% endif %}">{{ labels[forloop.index0] }}</a>
        {%- endfor -%}
      </div>
    </div>

    {%- if collection.products.size > 0 -%}
      {%- paginate collection.products by 24 -%}
        <div class="product-grid">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div style="display:flex;gap:8px;justify-content:center;align-items:center;padding:48px 0">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="btn btn-secondary btn-sm">Previous</a>
            {%- endif -%}
            <span class="muted" style="padding:0 16px">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="btn btn-secondary btn-sm">Next</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div style="padding:96px 0;text-align:center">
        <p class="lede">No products yet. Come back soon.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
