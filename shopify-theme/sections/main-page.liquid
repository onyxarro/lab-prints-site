<section>
  <div class="container">
    <div class="page-header" style="border:0;padding:48px 0 32px">
      <div class="eyebrow">{{ page.template_suffix | default: 'LAB Prints' | replace: '-', ' ' | capitalize }}</div>
      <h1 class="display display-l">{{ page.title }}</h1>
    </div>
    <div class="prose">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page content",
  "settings": []
}
{% endschema %}
